diff --git a/tests/pam_authenticator_cancellation_test.cpp b/tests/pam_authenticator_cancellation_test.cpp
new file mode 100644
index 0000000..6d7db5b
--- /dev/null
+++ b/tests/pam_authenticator_cancellation_test.cpp
@@ -0,0 +1,177 @@
+#include "auth/pam_authenticator.h"
+#include "auth/pam_helper_protocol.h"
+#include "test_check.h"
+
+#include <array>
+#include <cerrno>
+#include <charconv>
+#include <chrono>
+#include <climits>
+#include <csignal>
+#include <cstdint>
+#include <cstdlib>
+#include <future>
+#include <poll.h>
+#include <print>
+#include <stop_token>
+#include <string>
+#include <string_view>
+#include <sys/wait.h>
+#include <unistd.h>
+
+namespace {
+
+  using namespace std::chrono_literals;
+
+  // The authenticator execs NOCTALIA_PAM_HELPER_PATH with this argv[0]; pointing
+  // it at this executable lets the test impersonate the helper without PAM.
+  constexpr std::string_view kHelperName = "noctalia-pam-helper";
+  constexpr const char* kModeEnv = "NOCTALIA_TEST_PAM_HELPER_MODE";
+  constexpr const char* kReadyFdEnv = "NOCTALIA_TEST_PAM_HELPER_READY_FD";
+
+  const PamAuthenticator::Messages kMessages{
+      .startFailed = "helper did not complete",
+      .userUnavailable = "user unavailable",
+      .authenticationFailed = "rejected",
+  };
+
+  bool writeReply(pam_helper::Status status, std::int32_t pamRc) {
+    const auto statusByte = static_cast<std::uint8_t>(status);
+    return pam_helper::writeAll(STDOUT_FILENO, &pam_helper::kProtocolVersion, sizeof(pam_helper::kProtocolVersion))
+        && pam_helper::writeAll(STDOUT_FILENO, &statusByte, sizeof(statusByte))
+        && pam_helper::writeAll(STDOUT_FILENO, &pamRc, sizeof(pamRc));
+  }
+
+  int runTestHelper() {
+    ::alarm(10);
+    const char* modeEnv = std::getenv(kModeEnv);
+    TEST_CHECK(modeEnv != nullptr);
+    const std::string_view mode(modeEnv);
+
+    if (mode != "no-read") {
+      std::uint8_t version = 0;
+      TEST_CHECK(pam_helper::readAll(STDIN_FILENO, &version, sizeof(version)));
+      TEST_CHECK(version == pam_helper::kProtocolVersion);
+      std::uint32_t size = 0;
+      TEST_CHECK(pam_helper::readAll(STDIN_FILENO, &size, sizeof(size)));
+      TEST_CHECK(size <= pam_helper::kMaxPasswordBytes);
+      std::string password(size, '\0');
+      TEST_CHECK(size == 0 || pam_helper::readAll(STDIN_FILENO, password.data(), password.size()));
+    }
+
+    if (mode == "success" || mode == "failure" || mode == "after-result") {
+      const bool success = mode != "failure";
+      // 7 is PAM_AUTH_ERR.
+      TEST_CHECK(writeReply(success ? pam_helper::Status::Success : pam_helper::Status::Failed, success ? 0 : 7));
+      if (mode != "after-result") {
+        return success ? pam_helper::kExitSuccess : pam_helper::kExitFailure;
+      }
+    } else if (mode == "partial") {
+      TEST_CHECK(
+          pam_helper::writeAll(STDOUT_FILENO, &pam_helper::kProtocolVersion, sizeof(pam_helper::kProtocolVersion))
+      );
+    } else {
+      TEST_CHECK(mode == "no-read" || mode == "blocked");
+    }
+
+    const char* readyFdEnv = std::getenv(kReadyFdEnv);
+    TEST_CHECK(readyFdEnv != nullptr);
+    const std::string_view readyFdText(readyFdEnv);
+    int readyFd = -1;
+    const auto parsed = std::from_chars(readyFdText.data(), readyFdText.data() + readyFdText.size(), readyFd);
+    TEST_CHECK(parsed.ec == std::errc{});
+    TEST_CHECK(parsed.ptr == readyFdText.data() + readyFdText.size());
+    TEST_CHECK(readyFd >= 0);
+    const pid_t pid = ::getpid();
+    TEST_CHECK(pam_helper::writeAll(readyFd, &pid, sizeof(pid)));
+    while (true) {
+      ::pause();
+    }
+  }
+
+  void setMode(std::string_view mode) { TEST_CHECK(::setenv(kModeEnv, std::string(mode).c_str(), 1) == 0); }
+
+  void checkNoChildren() {
+    int status = 0;
+    TEST_CHECK(::waitpid(-1, &status, WNOHANG) == -1);
+    TEST_CHECK(errno == ECHILD);
+  }
+
+  void checkResults() {
+    const PamAuthenticator authenticator;
+    setMode("success");
+    TEST_CHECK(authenticator.authenticateCurrentUser("test", kMessages).success);
+    std::stop_source cancellation;
+    TEST_CHECK(authenticator.authenticateCurrentUser("test", kMessages, cancellation.get_token()).success);
+    setMode("failure");
+    const auto failure = authenticator.authenticateCurrentUser("test", kMessages, cancellation.get_token());
+    TEST_CHECK(!failure.success);
+    TEST_CHECK(failure.message != kMessages.startFailed);
+    // A completed attempt has no callback left that could signal another process.
+    TEST_CHECK(cancellation.request_stop());
+    checkNoChildren();
+  }
+
+  void checkAlreadyCancelled() {
+    setMode("success");
+    std::stop_source cancellation;
+    cancellation.request_stop();
+    const auto result = PamAuthenticator{}.authenticateCurrentUser("test", kMessages, cancellation.get_token());
+    TEST_CHECK(!result.success);
+    checkNoChildren();
+  }
+
+  void checkCancellation(std::string_view mode) {
+    int ready[2] = {-1, -1};
+    TEST_CHECK(::pipe(ready) == 0);
+    TEST_CHECK(::setenv(kReadyFdEnv, std::to_string(ready[1]).c_str(), 1) == 0);
+    setMode(mode);
+    std::stop_source cancellation;
+    const std::string password(mode == "no-read" ? pam_helper::kMaxPasswordBytes : 4, 'x');
+    auto result = std::async(std::launch::async, [&] {
+      return PamAuthenticator{}.authenticateCurrentUser(password, kMessages, cancellation.get_token());
+    });
+
+    pollfd readyPoll{.fd = ready[0], .events = POLLIN, .revents = 0};
+    TEST_CHECK(::poll(&readyPoll, 1, 2000) == 1);
+    pid_t helperPid = -1;
+    TEST_CHECK(pam_helper::readAll(ready[0], &helperPid, sizeof(helperPid)));
+    TEST_CHECK(cancellation.request_stop());
+    TEST_CHECK(result.wait_for(2s) == std::future_status::ready);
+    const auto cancelled = result.get();
+    TEST_CHECK(!cancelled.success);
+    TEST_CHECK(cancelled.message == kMessages.startFailed);
+    TEST_CHECK(::kill(helperPid, 0) == -1);
+    TEST_CHECK(errno == ESRCH);
+    ::close(ready[0]);
+    ::close(ready[1]);
+    checkNoChildren();
+
+    // A new attempt works without waiting for the abandoned one.
+    setMode("success");
+    TEST_CHECK(PamAuthenticator{}.authenticateCurrentUser("test", kMessages).success);
+  }
+
+} // namespace
+
+int main(int argc, char* argv[]) {
+  if (argc == 1 && std::string_view(argv[0]) == kHelperName) {
+    return runTestHelper();
+  }
+  ::alarm(30);
+
+  std::array<char, PATH_MAX> exe{};
+  const ssize_t n = ::readlink("/proc/self/exe", exe.data(), exe.size() - 1);
+  TEST_CHECK(n > 0);
+  TEST_CHECK(::setenv("NOCTALIA_PAM_HELPER_PATH", exe.data(), 1) == 0);
+
+  checkResults();
+  checkAlreadyCancelled();
+  for (int attempt = 0; attempt < 5; ++attempt) {
+    checkCancellation("no-read");
+    checkCancellation("blocked");
+    checkCancellation("partial");
+    checkCancellation("after-result");
+  }
+  std::println("PAM helper cancellation: all checks passed");
+}
